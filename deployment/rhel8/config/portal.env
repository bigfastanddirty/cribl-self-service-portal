NODE_ENV=production
PORT=4173
# Replace with the reachable Cribl Leader URL. No dev VM address is packaged.
CRIBL_URL=http://127.0.0.1:9000
CRIBL_CREDENTIALS_FILE=/etc/cribl-self-service/credentials.json
# Empty mapping leaves HEC provisioning unavailable until explicitly configured.
HEC_TARGETS_FILE=/etc/cribl-self-service/hec-targets.json
HEC_STATE_DIR=/var/lib/cribl-self-service/hec-requests
# Email delivery remains paused. Uncomment only when configured:
# SMTP_CONFIG_FILE=/etc/cribl-self-service/smtp.json
# NOTIFICATION_STATE_DIR=/var/lib/cribl-self-service/notifications
